{
  "manifest_version": 3,
  "name": "EduChat – College Admissions Q&A",
  "version": "1.1.0",
  "description": "Ask admissions questions about top US business schools, powered by official admission pages.",
  "action": {
    "default_title": "Open EduChat",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://educhat-6lzs.onrender.com/*"
  ],
  "permissions": [
    "sidePanel",
    "storage"
  ]
}
